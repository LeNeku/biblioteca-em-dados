# Não versione o arquivo .env com credenciais reais.
PORT=3000
NODE_ENV=development

DB_SERVER=seu-servidor.database.windows.net
DB_PORT=1433
DB_DATABASE=sua-base
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Azure SQL configurado apenas para Microsoft Entra ID.
DB_AUTHENTICATION=azure-active-directory-default
# Desenvolvimento local: instale Azure CLI e execute `az login`.
# Em App Service: use Managed Identity com acesso ao banco.

# Para autenticação SQL tradicional somente: remova DB_AUTHENTICATION e preencha:
# DB_USER=seu-usuario
# DB_PASSWORD=sua-senha
